DATABASE_URL=postgresql+psycopg://evalpulse:evalpulse@postgres:5432/evalpulse
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
WEB_PORT=3000
API_PORT=8000

# Optional paid/free-tier Gemini integration. The mock provider remains the default.
LLM_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MAX_CASES_PER_RUN=20
LLM_DAILY_REQUEST_LIMIT=100
LLM_DAILY_DIAGNOSIS_LIMIT=20
