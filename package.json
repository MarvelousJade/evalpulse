{
  "name": "evalpulse",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.12 <25"
  },
  "workspaces": [
    "apps/web",
    "packages/api-client",
    "tests/e2e"
  ],
  "dependencies": {
    "next": "16.4.0",
    "sharp": "0.35.5"
  },
  "overrides": {
    "next": {
      ".": "$next",
      "sharp": "$sharp"
    }
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
